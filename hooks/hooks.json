{
  "description": "non-dev-token-saver: Bash 명령을 rtk로 바꿔 출력 길이를 줄이는 훅",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/rtk-rewrite.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
